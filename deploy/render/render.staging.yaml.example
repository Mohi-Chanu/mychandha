# NON-LIVE EXAMPLE ONLY.
# Do not rename, sync, or apply this file until CC-001 external-resource and
# staging-execution approvals provide the immutable image value and the
# resulting adapter passes validation.
previews:
  generation: off

services:
  - type: web
    name: mychandha-staging-api
    runtime: image
    plan: starter
    region: singapore
    numInstances: 1
    maxShutdownDelaySeconds: 30
    image:
      url: REPLACE_AFTER_EXTERNAL_APPROVAL/IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST
    healthCheckPath: /actuator/health/readiness
    envVars:
      - key: SPRING_PROFILES_ACTIVE
        value: production,api
      - key: API_DATABASE_URL
        sync: false
      - key: API_DATABASE_USERNAME
        sync: false
      - key: API_DATABASE_PASSWORD
        sync: false
      - key: SUPABASE_JWT_ISSUER
        sync: false
      - key: SUPABASE_JWKS_URI
        sync: false
      - key: SUPABASE_JWT_AUDIENCE
        value: authenticated
      - key: RATE_LIMIT_ENABLED
        value: "true"
      - key: RATE_LIMIT_TRUST_FORWARDED
        value: "true"
      - key: RATE_LIMIT_TRUSTED_PROXY_CIDRS
        sync: false

  - type: worker
    name: mychandha-staging-dispatcher
    runtime: image
    plan: starter
    region: singapore
    numInstances: 1
    maxShutdownDelaySeconds: 30
    image:
      url: REPLACE_AFTER_EXTERNAL_APPROVAL/IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST
    envVars:
      - key: SPRING_PROFILES_ACTIVE
        value: production,dispatcher
      - key: DISPATCHER_DATABASE_URL
        sync: false
      - key: DISPATCHER_DATABASE_USERNAME
        sync: false
      - key: DISPATCHER_DATABASE_PASSWORD
        sync: false
