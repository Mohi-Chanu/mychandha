# NON-LIVE PRIVILEGED JOB-BASE EXAMPLE ONLY.
# Never combine this file with the long-running service adapter. Create only
# the separately approved base for the matching operation and delete it no
# later than one hour after its one-off job reaches a terminal state.
previews:
  generation: off

services:
  - type: worker
    name: mychandha-staging-bootstrap-base
    runtime: image
    plan: starter
    region: singapore
    numInstances: 1
    maxShutdownDelaySeconds: 30
    dockerCommand: /app/ops/run-idle.sh
    image:
      url: REPLACE_AFTER_EXTERNAL_APPROVAL/IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST
    envVars:
      - key: BOOTSTRAP_DATABASE_HOST
        sync: false
      - key: BOOTSTRAP_DATABASE_PORT
        value: "5432"
      - key: BOOTSTRAP_DATABASE_NAME
        sync: false
      - key: BOOTSTRAP_DATABASE_USERNAME
        sync: false
      - key: BOOTSTRAP_DATABASE_PASSWORD
        sync: false
      - key: BOOTSTRAP_DATABASE_SSL_ROOT_CERTIFICATE
        value: /etc/secrets/supabase-ca.crt
      - key: MYCHANDHA_STAGING_API_PASSWORD
        sync: false
      - key: MYCHANDHA_STAGING_DISPATCHER_PASSWORD
        sync: false
      - key: MYCHANDHA_STAGING_MIGRATION_PASSWORD
        sync: false

  - type: worker
    name: mychandha-staging-migration-base
    runtime: image
    plan: starter
    region: singapore
    numInstances: 1
    maxShutdownDelaySeconds: 30
    dockerCommand: /app/ops/run-idle.sh
    image:
      url: REPLACE_AFTER_EXTERNAL_APPROVAL/IMAGE@sha256:REPLACE_WITH_64_HEX_DIGEST
    envVars:
      - key: SPRING_PROFILES_ACTIVE
        value: production,migration
      - key: MIGRATION_DATABASE_URL
        sync: false
      - key: MIGRATION_DATABASE_USERNAME
        sync: false
      - key: MIGRATION_DATABASE_PASSWORD
        sync: false
      - key: MIGRATION_DATABASE_SSL_ROOT_CERTIFICATE
        value: /etc/secrets/supabase-ca.crt
