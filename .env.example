SPRING_PROFILES_ACTIVE=local
DATABASE_URL=jdbc:postgresql://localhost:5432/mychandha
DATABASE_USERNAME=mychandha_owner
DATABASE_PASSWORD=change-me
# Deployed profiles use only their own credential class:
# API_DATABASE_URL=jdbc:postgresql://database:5432/mychandha
# API_DATABASE_USERNAME=mychandha_api_login
# API_DATABASE_PASSWORD=set-in-an-approved-secret-store
# DISPATCHER_DATABASE_URL=jdbc:postgresql://database:5432/mychandha
# DISPATCHER_DATABASE_USERNAME=mychandha_dispatcher_login
# DISPATCHER_DATABASE_PASSWORD=set-in-an-approved-secret-store
# MIGRATION_DATABASE_URL=jdbc:postgresql://database:5432/mychandha
# MIGRATION_DATABASE_USERNAME=mychandha_migration_login
# MIGRATION_DATABASE_PASSWORD=set-in-an-approved-secret-store
SUPABASE_PROJECT_URL=https://your-project.supabase.co
SUPABASE_JWT_ISSUER=https://your-project.supabase.co/auth/v1
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
OUTBOX_POLL_DELAY=PT1S
OUTBOX_LOCK_TIMEOUT=PT2M
